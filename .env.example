# ---------------------------------------------------------------------------
# Authentication — pick ONE of the two modes below.
# ---------------------------------------------------------------------------

# Mode 1: API key. Read-only public data. No Analytics, no writes, no captions.
# Google Cloud Console -> APIs & Services -> Credentials -> Create API key.
YOUTUBE_API_KEY=

# Mode 2: OAuth 2.0. Needed for Analytics, captions and any write operation.
# Google Cloud Console -> Credentials -> OAuth client ID -> type "Desktop app".
# If both modes are configured, OAuth wins and the API key is the fallback.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Must match a redirect URI registered on the OAuth client. Nothing has to listen
# on it: you copy the resulting URL out of the browser's address bar by hand.
# YOUTUBE_REDIRECT_URI=http://localhost:8790/oauth2callback

# ---------------------------------------------------------------------------
# Capabilities — both default to OFF.
# ---------------------------------------------------------------------------

# Allow tools that modify your channel (update_video, reply_to_comment,
# set_thumbnail, playlist changes). While false, those tools are not even
# advertised, and the OAuth scope requested stays read-only.
# Changing this requires re-authorizing, because the scope changes.
# YOUTUBE_ALLOW_WRITES=false

# Allow list_captions and get_transcript. Downloading captions requires the
# youtube.force-ssl scope, which is broader than read-only, so this is opt-in
# even though reading a transcript is not a write.
# YOUTUBE_ENABLE_CAPTIONS=false

# ---------------------------------------------------------------------------
# Paths and limits (optional).
# ---------------------------------------------------------------------------

# Where the OAuth token is stored. Written with 0600. Defaults to ./token.json.
# YOUTUBE_TOKEN_PATH=/absolute/path/to/token.json

# Append-only JSONL record of every write attempt, allowed or blocked.
# Defaults to youtube-mcp-audit.log next to the token file.
# YOUTUBE_AUDIT_LOG=/absolute/path/to/youtube-mcp-audit.log

# Maximum thumbnail size in bytes. YouTube's own limit is 2 MB.
# YOUTUBE_MAX_THUMBNAIL_BYTES=2097152
